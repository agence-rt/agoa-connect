# Copier ce fichier en « .env » sur le serveur, puis remplir. Ne jamais committer « .env ».

# Nom de domaine qui pointe vers le serveur (enregistrement DNS de type A, sans proxy CDN).
DOMAIN=connect.exemple.fr

# Adresse IPv4 publique du serveur (pour le relais TURN).
PUBLIC_IP=203.0.113.10

# Clé commune à tous les postes de l'agence : openssl rand -base64 32
AGENCY_KEY=

# Identifiants du relais TURN : TURN_PASSWORD s'obtient avec  openssl rand -base64 24
TURN_USER=connect
TURN_PASSWORD=
