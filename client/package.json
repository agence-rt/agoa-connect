{
  "name": "connect",
  "productName": "CONNECT",
  "version": "0.1.0",
  "description": "CONNECT : présenter son écran ou prendre le contrôle d’un autre poste de l’agence, par Internet",
  "main": "main.js",
  "private": true,
  "scripts": {
    "sync-hub": "node -e \"require('fs').copyFileSync('../server/hub.js','hub.js')\"",
    "start": "npm run sync-hub && electron .",
    "test": "npm run sync-hub && node test/direct.test.js",
    "dist": "npm run sync-hub && electron-builder"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "fr.remithollet.connect",
    "productName": "CONNECT",
    "files": [
      "main.js",
      "preload.js",
      "direct.js",
      "hub.js",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@nut-tree-fork/**",
      "node_modules/@nut-tree/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "directories": {
      "buildResources": "build"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "CONNECT"
    }
  }
}
